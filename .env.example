# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option A — OpenAI (cloud)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

